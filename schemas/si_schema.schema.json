        "assumed": {
          "default": false,
          "title": "Assumed",
          "type": "boolean"
        },
        "source_doc_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Doc Ref"
        }
      },
      "required": [
        "id",
        "signal_order",
        "signal_name",
        "from_system",
        "to_system",
        "function_category",
        "data_type",
        "expected_value"
      ],
      "title": "Signal",
      "type": "object"
    },
    "SignalSubtype": {
      "enum": [
