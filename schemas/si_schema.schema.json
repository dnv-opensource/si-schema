      },
      "required": [
        "entries"
      ],
      "title": "DiscreteMapping",
      "type": "object"
    },
    "ExpectedValueDiscrete": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Raw"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meaning"
        }
      },
      "required": [
        "raw"
      ],
      "title": "ExpectedValueDiscrete",
      "type": "object"
    },
    "ExpectedValueLinear": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "$ref": "#/$defs/ValueScalar"
        },
        "physical": {
          "$ref": "#/$defs/ValueScalar"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meaning"
        }
      },
      "required": [
        "raw",
        "physical"
      ],
      "title": "ExpectedValueLinear",
      "type": "object"
    },
    "Function": {
      "additionalProperties": false,
      "properties": {
        "no": {
          "minimum": 1,
          "title": "No",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "function_category": {
          "$ref": "#/$defs/FunctionCategory"
        },
        "control_authority": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Control Authority",
          "type": "string"
        },
        "related_systems": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Related Systems",
          "type": "array"
        },
        "interactions": {
          "items": {
            "$ref": "#/$defs/Interaction"
          },
          "title": "Interactions",
          "type": "array"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "no",
        "name",
        "function_category",
        "control_authority"
      ],
      "title": "Function",
      "type": "object"
    },
    "FunctionCategory": {
      "enum": [
        "Command",
        "Status",
        "Alarm",
        "Indication",
        "Permissive",
        "Other"
