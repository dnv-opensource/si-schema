      "title": "FunctionCategory",
      "type": "string"
    },
    "Interaction": {
      "additionalProperties": false,
      "properties": {
        "no": {
          "minimum": 1,
          "title": "No",
          "type": "integer"
        },
        "from_ref": {
          "$ref": "#/$defs/SystemRef"
        },
        "to_ref": {
          "$ref": "#/$defs/SystemRef"
        },
        "link_type": {
          "$ref": "#/$defs/LinkType"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "signal_refs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Signal Refs",
          "type": "array"
        }
      },
      "required": [
        "no",
        "from_ref",
        "to_ref",
        "link_type",
        "label"
      ],
      "title": "Interaction",
      "type": "object"
    },
    "LinearMapping": {
      "additionalProperties": false,
