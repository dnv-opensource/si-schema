          "default": null,
          "title": "Function Subcategory"
        },
        "data_type": {
          "$ref": "#/$defs/DataType"
        },
        "subtype": {
          "items": {
            "$ref": "#/$defs/SignalSubtype"
          },
          "title": "Subtype",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        },
        "value_mapping": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "discrete": "#/$defs/DiscreteMapping",
                  "linear": "#/$defs/LinearMapping"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/DiscreteMapping"
                },
                {
                  "$ref": "#/$defs/LinearMapping"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Mapping"
        },
        "expected_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpectedValueDiscrete"
            },
            {
              "$ref": "#/$defs/ExpectedValueLinear"
            }
          ],
          "title": "Expected Value"
        },
        "value_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Description"
        },
        "pulse_shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/PulseShape"
            },
            {
              "type": "null"
            }
          ],
          "default": null
